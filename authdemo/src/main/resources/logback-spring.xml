<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Appender de console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender de arquivo com rotação diária -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/auditoria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/auditoria.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender de banco de dados — proteção contra alteração dos logs de auditoria -->
    <appender name="DB" class="ch.qos.logback.classic.db.DBAppender">
        <connectionSource class="ch.qos.logback.core.db.DriverManagerConnectionSource">
            <driverClass>org.postgresql.Driver</driverClass>
            <url>${DB_URL}</url>
            <user>${DB_USERNAME}</user>
            <password>${DB_PASSWORD}</password>
        </connectionSource>
    </appender>

    <!-- Logger específico de auditoria — grava em arquivo e banco -->
    <logger name="com.pfc.suaoficina.authdemo.service.UserService"
            level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
        <appender-ref ref="DB"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root logger — console apenas -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>